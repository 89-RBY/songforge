# Copia questo file in .env e compila i valori. Non committare .env.

# PostgreSQL (in locale: un database dedicato, es. songforge)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/songforge"
# Database separato usato solo dai test di integrazione
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/songforge_test"

# URL pubblico dell'app. Auth.js lo usa per costruire i link di accesso.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Segreto per firmare le sessioni: almeno 32 caratteri. Generalo con: openssl rand -base64 48
AUTH_SECRET=""

# Email di accesso. "console" stampa il link nei log (solo sviluppo).
# In produzione usa "smtp" con SMTP_URL, es. smtps://utente:password@smtp.tuodominio.it:465
EMAIL_TRANSPORT="console"
EMAIL_FROM="SongForge <no-reply@tuodominio.it>"
SMTP_URL=""

# Login con Google (opzionale). Vanno impostate insieme.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
