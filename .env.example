# Copia questo file in .env e compila i valori. Non committare .env.

# PostgreSQL (in locale: un database dedicato, es. songforge)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/songforge"
# Database separato usato solo dai test di integrazione
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/songforge_test"

# URL pubblico dell'app. Auth.js lo usa per costruire i link di accesso.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Segreto per firmare le sessioni: almeno 32 caratteri. Generalo con: openssl rand -base64 48
AUTH_SECRET=""

# Email di accesso. "console" stampa il link nei log (solo sviluppo).
# In produzione usa "smtp" con SMTP_URL, es. smtps://utente:password@smtp.tuodominio.it:465
EMAIL_TRANSPORT="console"
EMAIL_FROM="SongForge <no-reply@tuodominio.it>"
SMTP_URL=""

# Login con Google (opzionale). Vanno impostate insieme.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Provider musicali. Almeno uno tra GEMINI_API_KEY e MOCK_PROVIDER.
# MOCK_PROVIDER=true genera audio di prova senza chiamare nessun servizio (solo sviluppo).
MOCK_PROVIDER="false"
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
LYRIA_SONG_MODEL="lyria-3.5"
LYRIA_CLIP_MODEL="lyria-3-clip-preview"
LYRIA_TIMEOUT_MS="600000"
MOCK_DELAY_MS="1500"
# Solo sviluppo: costo simulato di una clip, in centesimi di euro, per provare gli addebiti crediti.
MOCK_COST_CENTS="0"

# Storage dell'audio. "local" per lo sviluppo, "s3" per Cloudflare R2 o altro storage S3-compatibile.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/audio"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Intervallo di controllo della coda del worker, in millisecondi.
WORKER_POLL_MS="2000"

# Testi delle canzoni (Claude). Se manca la chiave, il wizard usa il testo scritto dal modello musicale.
ANTHROPIC_API_KEY=""
LYRICS_MODEL="claude-opus-5-5"

# Conservazione dell'audio: dopo questo numero di giorni l'audio viene rimosso (la canzone resta, senza audio).
AUDIO_RETENTION_DAYS="90"

# Pagamenti con Stripe (crediti). Vanno impostate insieme. Usa le chiavi di test finché non sei pronto.
# Il webhook va configurato su APP_URL/api/stripe/webhook, evento checkout.session.completed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Limiti di richiesta. Dietro il proxy Caddy (docker-compose) imposta TRUST_PROXY="true", così i limiti per indirizzo IP funzionano.
TRUST_PROXY="false"

# Verifica dei contenuti con Claude (secondo livello, oltre alla lista di artisti). Richiede ANTHROPIC_API_KEY.
MODERATION_MODEL="claude-haiku-5-5"

# Deploy con docker-compose (solo per il server): dominio pubblico e password del database.
APP_DOMAIN="songforge.tuodominio.it"
POSTGRES_PASSWORD=""

