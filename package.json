{
  "name": "songforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.0",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "nodemailer": "10.1.0",
    "deepmerge-ts": ">=8.0.0",
    "mysql2": ">=3.23.1",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "fast-glob": "^3.3.3"
  }
}
